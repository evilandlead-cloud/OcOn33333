<view class="shell">
  <view class="brand"><text class="brand-mark">◒</text><text>动日 MOTION</text><text class="brand-right">让运动成为日常</text></view>
  <view class="intro"><text class="eyebrow">YOUR DAILY MOVEMENT</text><view class="title">每一份坚持，都算数。</view><view class="subtitle">不必追赶别人，记录自己的节奏。</view></view>
  <view class="tabs"><view class="tab {{tab==='today'?'active':''}}" data-tab="today" bindtap="switchTab">今日记录</view><view class="tab {{tab==='history'?'active':''}}" data-tab="history" bindtap="switchTab">运动历史</view><view class="tab {{tab==='stats'?'active':''}}" data-tab="stats" bindtap="switchTab">数据统计</view></view>
  <view wx:if="storageError" class="empty"><view>暂时无法读取本地记录</view><button bindtap="refresh">点击重试</button></view>
  <block wx:else>
  <view wx:if="tab==='today'" class="hero"><view class="hero-top"><text>今日运动 · {{today}}</text><text class="badge">{{todayMinutes>0?'已开始积累':'新的起点'}}</text></view><view class="hero-number">{{todayMinutes}}<text> 分钟</text></view><view class="hero-bottom"><text>{{todayMinutes>0?'今天的努力，已为你记下。':'从一次散步开始，也很好。'}}</text><text class="hero-symbol">↗</text></view></view>
  <view wx:if="tab==='stats'">
    <view class="section-heading"><text>积累的力量</text><text class="muted">每一次都值得</text></view>
    <view class="metrics"><view><text class="metric-number">{{stats.days}}</text><text>运动天数</text></view><view><text class="metric-number">{{stats.total}}</text><text>累计分钟</text></view><view><text class="metric-number">{{stats.streak}}</text><text>连续天数</text></view></view>
    <view class="chart-card"><view class="section-heading"><text>最近 7 天</text><text class="muted">{{stats.weekTotal}} 分钟</text></view><view class="chart"><view class="chart-column" wx:for="{{stats.week}}" wx:key="date"><text class="chart-value">{{item.minutes}}</text><view class="bar-track"><view class="bar" style="{{'height:' + item.height + '%;'}}"></view></view><text class="chart-label">{{item.label}}</text></view></view><view class="footnote">连续天数从今天或昨天起计算</view></view>
  </view>
  <block wx:else>
    <view class="section-heading"><text>{{tab==='today'?'今天的运动':'全部运动记录'}}</text><text class="muted">{{visible.length}} 条记录</text></view>
    <view wx:if="visible.length===0" class="empty"><view class="empty-icon">↗</view><view class="empty-title">{{tab==='today'?'今天，动一点点':'你的运动故事，从这里开始'}}</view><view class="muted">记录一次运动，积累一点改变。</view><button class="small-add" bindtap="openForm">＋ 记录运动</button></view>
    <view class="record" wx:for="{{visible}}" wx:key="id"><view class="record-main"><view class="sport-icon">{{item.type==='跑步'?'跑':item.type==='步行'?'走':item.type==='骑行'?'骑':item.type==='力量'?'练':item.type==='瑜伽'?'瑜':'动'}}</view><view class="record-info"><view class="record-title">{{item.type}}<text>{{item.duration}} 分钟</text></view><view class="muted">{{item.date}} · {{item.feeling}}</view></view></view><view wx:if="item.note" class="note">{{item.note}}</view><view class="record-actions"><text data-id="{{item.id}}" bindtap="edit">编辑</text><text data-id="{{item.id}}" bindtap="remove">删除</text></view></view>
  </block>
  </block>
  <view class="footer">为自己而动 · 数据仅保存在当前设备</view>
  <button class="add-button" bindtap="openForm">＋ 记录一次运动</button>
</view>
<view wx:if="showForm" class="overlay" bindtap="closeForm"><view class="sheet" catchtap="noop"><view class="sheet-heading"><text>{{editingId?'编辑运动':'记录一次运动'}}</text><button class="close" bindtap="closeForm">×</button></view><scroll-view scroll-y class="form-scroll"><view class="label">运动日期</view><picker mode="date" value="{{date}}" end="{{today}}" data-field="date" bindchange="input"><view class="input">{{date}}<text class="picker-arrow">⌄</text></view></picker><view class="label">运动类型</view><view class="chips"><view wx:for="{{types}}" wx:key="*this" class="chip {{type===item?'selected':''}}" data-field="type" data-value="{{item}}" bindtap="choose">{{item}}</view></view><view class="label">运动时长 <text class="muted">/ 分钟</text></view><input class="input" type="number" maxlength="4" placeholder="例如：30" value="{{duration}}" data-field="duration" bindinput="input"/><view class="label">运动感受</view><view class="chips feelings"><view wx:for="{{feelings}}" wx:key="*this" class="chip {{feeling===item?'selected':''}}" data-field="feeling" data-value="{{item}}" bindtap="choose">{{item}}</view></view><view class="label">随手记 <text class="muted">/ 选填</text></view><textarea class="input textarea" placeholder="今天的状态、路线，或一点小进步…" maxlength="120" value="{{note}}" data-field="note" bindinput="input"/><view class="counter">{{note.length}} / 120</view><button class="save" bindtap="submit">保存记录</button></scroll-view></view></view>
